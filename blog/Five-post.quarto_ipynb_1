    "# ── 1. Pearson correlations ──────────────────────────────────────────────────\n",
    "pearson = Xdf.corrwith(df_clean[y_col])\n",
    "\n",
    "# ── 2. Standardized regression coefficients (beta weights) ──────────────────\n",
    "Xstd   = (Xdf - Xdf.mean()) / Xdf.std()\n",
    "ystd_v = (y - y.mean()) / y.std()\n",
    "beta   = pd.Series(\n",
    "    LinearRegression().fit(Xstd.values, ystd_v).coef_,\n",
    "    index=x_cols\n",
    ")\n",
    "\n",
    "# ── 3. Drop-one (\"usefulness\") ───────────────────────────────────────────────\n",
    "full_r2  = r2_score(y, LinearRegression().fit(X, y).predict(X))\n",
    "\n",
    "drop_one = {}\n",
    "for col in x_cols:\n",
    "    minus = [c for c in x_cols if c != col]\n",
    "    r2m   = r2_score(\n",
    "        y,\n",
    "        LinearRegression().fit(Xdf[minus].values, y).predict(Xdf[minus].values)\n",
    "    )\n",
    "    drop_one[col] = full_r2 - r2m\n",
    "drop_one = pd.Series(drop_one)\n",
    "\n",
    "print(f\"Full model R²: {full_r2:.4f}\")\n",
    "\n",
    "# ── 4. Shapley values (exact enumeration, R² metric) ────────────────────────\n",
    "def r2_subset(indices):\n",
    "    if len(indices) == 0:\n",
    "        return 0.0\n",
    "    m = LinearRegression().fit(X[:, list(indices)], y)\n",
    "    return r2_score(y, m.predict(X[:, list(indices)]))\n",
    "\n",
    "shap = np.zeros(k)\n",
    "for i in range(k):\n",
    "    others = [j for j in range(k) if j != i]\n",
    "    for size in range(len(others) + 1):\n",
    "        for subset in combinations(others, size):\n",
    "            s      = len(subset)\n",
    "            w      = factorial(s) * factorial(k - s - 1) / factorial(k)\n",
    "            margin = r2_subset(list(subset) + [i]) - r2_subset(list(subset))\n",
    "            shap[i] += w * margin\n",
    "\n",
    "shapley = pd.Series(shap, index=x_cols)\n",
    "print(f\"Shapley values sum to R²: {shapley.sum():.4f}  (Full R² = {full_r2:.4f})\")\n",
    "\n",
    "# ── 5. Johnson's relative weights ────────────────────────────────────────────\n",
    "eigenvalues, eigenvectors = np.linalg.eigh(np.corrcoef(Xstd.T))\n",
    "Z       = Xstd.values @ eigenvectors @ np.diag(1.0 / np.sqrt(eigenvalues))\n",
    "betas_z = np.linalg.lstsq(Z, ystd_v, rcond=None)[0]\n",
    "\n",
    "RW_raw = np.array([\n",
    "    sum((eigenvectors[i, j] * np.sqrt(eigenvalues[j]) * betas_z[j]) ** 2\n",
    "        for j in range(k))\n",
    "    for i in range(k)\n",
    "])\n",
    "johnson = pd.Series(RW_raw / RW_raw.sum() * full_r2, index=x_cols)\n",
    "print(f\"Johnson RW sum: {johnson.sum():.4f}  (Full R² = {full_r2:.4f})\")\n",
    "\n",
    "# ── 6. Random forest mean decrease in Gini ───────────────────────────────────\n",
    "rf   = RandomForestRegressor(n_estimators=500, random_state=42, n_jobs=-1)\n",
    "rf.fit(X, y)\n",
    "gini = pd.Series(rf.feature_importances_, index=x_cols)\n",
    "print(f\"RF Gini importances sum: {gini.sum():.4f}\")"
   ]
