    "def shapley_values_custom(X_arr, y_arr, feature_names):\n",
    "    \"\"\"\n",
    "    Compute exact Shapley values for linear regression using R² as the fit metric.\n",
    "    Complexity: O(k * 2^k) model fits.\n",
    "    \"\"\"\n",
    "    n_feat = X_arr.shape[1]\n",
    "    shap_out = np.zeros(n_feat)\n",
    "\n",
    "    def r2_sub(cols):\n",
    "        if not cols:\n",
    "            return 0.0\n",
    "        m = LinearRegression().fit(X_arr[:, cols], y_arr)\n",
    "        return r2_score(y_arr, m.predict(X_arr[:, cols]))\n",
    "\n",
    "    for i in range(n_feat):\n",
    "        others = [j for j in range(n_feat) if j != i]\n",
    "        for size in range(len(others) + 1):\n",
    "            for subset in combinations(others, size):\n",
    "                s      = len(subset)\n",
    "                w      = (factorial(s) * factorial(n_feat - s - 1)\n",
    "                          / factorial(n_feat))\n",
    "                margin = r2_sub(list(subset) + [i]) - r2_sub(list(subset))\n",
    "                shap_out[i] += w * margin\n",
    "\n",
    "    return pd.Series(shap_out, index=feature_names)\n",
    "\n",
    "custom_shap = shapley_values_custom(X, y, x_cols)\n",
